// Share the machine with other jobs: caps the whole run, not just each task
// (resourceLimits alone caps each task, and the local executor would still run
// as many tasks at once as fit in home.config's 44 CPUs / 120 GB).
// Usage: ./run_rnaseq.sh -c share.config
executor {
    cpus   = 16
    memory = 48.GB
}
process {
    resourceLimits = [cpus: 16, memory: 48.GB, time: 48.h]
}
