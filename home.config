// Machine-specific limits for the home PC. Set these to what the machine has
// (leave a couple of cores / a few GB for the OS). Building the Salmon index
// for the human genome + decoys needs roughly 20-32 GB of RAM.
process {
    resourceLimits = [
        cpus:   44,         // Threadripper, 48 threads
        memory: 120.GB,     // 128 GB ECC
        time:   48.h
    ]
}
